# VoidMain — environment reference (copy to .env or export before launch)
# Nothing here talks to the internet: the broker, backend, and dashboard are
# all LAN / localhost only.

# ── HTTP ──────────────────────────────────────────────────────────────────── #
VOIDMAIN_HTTP_HOST=0.0.0.0
VOIDMAIN_HTTP_PORT=8080

# ── MQTT broker ───────────────────────────────────────────────────────────── #
VOIDMAIN_MQTT_HOST=127.0.0.1
VOIDMAIN_MQTT_PORT=1883
VOIDMAIN_MQTT_USER=dash
VOIDMAIN_MQTT_PASS=

# ── Evidence DB (SQLite) ──────────────────────────────────────────────────── #
VOIDMAIN_EVIDENCE_DB=./evidence.db

# ── LAN demo rig ──────────────────────────────────────────────────────────── #
# allow_lan lets other machines on the LAN reach the dashboard; the demo code
# is the shared LAN access code those machines sign in with.
VOIDMAIN_ALLOW_LAN=0
VOIDMAIN_DEMO_CODE=

# ── Console assistant (local RAG + Ollama) ────────────────────────────────── #
VOIDMAIN_AI=1
VOIDMAIN_OLLAMA_URL=http://127.0.0.1:11434
VOIDMAIN_AI_MODEL=qwen3:8b
VOIDMAIN_AI_TIMEOUT=60

# ── Auth ──────────────────────────────────────────────────────────────────── #
VOIDMAIN_AUTH_DB=./auth.db
VOIDMAIN_RP_ID=localhost
VOIDMAIN_RP_NAME=VoidMain
VOIDMAIN_ORIGINS=http://localhost:5173,http://localhost:8080
VOIDMAIN_SESSION_TTL=3600

# ── Debug console (dev only) ──────────────────────────────────────────────── #
VOIDMAIN_DEBUG=0
VOIDMAIN_DEBUG_USER=admin
VOIDMAIN_DEBUG_PASS=

# ── TLS (optional) ────────────────────────────────────────────────────────── #
VOIDMAIN_TLS_CERT=
VOIDMAIN_TLS_KEY=
VOIDMAIN_HTTPS_PORT=443
